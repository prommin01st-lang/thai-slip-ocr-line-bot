# Copy to .env on the target VM, chmod 600; fill secrets there. Never commit real values.
NODE_ENV=production
PORT=3000
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
ADMIN_USERS=
ALLOWED_USERS=
PUBLIC_URL=
# Generate locally: openssl rand -hex 32 (same value passed to both services by compose)
OCR_TOKEN=
OCR_ENDPOINT=http://ocr:8101
OCR_TIMEOUT_MS=180000
OCR_THREADS=2
MAX_IMAGE_BYTES=10485760
MAX_PDF_BYTES=10485760
MAX_TEXT_BYTES=2097152
DB_PATH=/app/data/slipingman.db
EXPORT_CSV=off
# Optional Google integration: supply both or leave both empty.
GOOGLE_SA_EMAIL=
GOOGLE_SA_KEY=
SHEET_SYNC_MS=20000
CHECK_SPREADSHEET_ID=
# Switch on after private bucket, credentials, read/write/delete and GC have been verified.
EVIDENCE_ENABLED=off
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Allow plain HTTP only for storage:8333 on the isolated Docker network in compose.storage.yml.
S3_INTERNAL_NETWORK=off
