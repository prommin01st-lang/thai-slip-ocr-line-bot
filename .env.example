# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (.env ถูก gitignore ไว้แล้ว)
#
# หาค่าได้ที่ https://developers.line.biz/console/
#   LINE_CHANNEL_SECRET       → แท็บ "Basic settings"  → Channel secret
#   LINE_CHANNEL_ACCESS_TOKEN → แท็บ "Messaging API"   → Channel access token (long-lived)

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# พอร์ตของ webhook server ตัวนี้ (ต้องตรงกับที่เปิด tailscale funnel)
PORT=3000

# slip-ocr-th/serve.py — ตัวที่โหลด Unlimited-OCR 4-bit ไว้
OCR_ENDPOINT=http://localhost:8100

# ต้องมากกว่า SLIP_OCR_MAX_SECONDS ของ serve.py (default 150s) เผื่อเวลารอคิว
OCR_TIMEOUT_MS=180000

# ขนาดรูปสูงสุดที่ยอมรับ (bytes) — LINE จำกัด 10MB อยู่แล้ว
MAX_IMAGE_BYTES=10485760

# ---- สำหรับ line-bot-mcp-server (ให้ Claude สั่งส่งข้อความทดสอบ / สร้าง rich menu) ----
# .mcp.json อ่านสองตัวนี้จาก environment ของ shell ที่เปิด Claude Code
# ตั้งด้วย:  export $(grep -v '^#' .env | xargs)   ก่อนเปิด claude
LINE_DESTINATION_USER_ID=

# shared token กับ backend (ว่าง = ไม่ใช้ auth)
OCR_TOKEN=

# จำนวน thread ที่ PaddleOCR ใช้ — ตั้งให้เท่าจำนวน core จริงของเครื่อง (VPS 2 cores → 2)
OCR_THREADS=2
