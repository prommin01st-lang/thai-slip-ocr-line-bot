# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (.env ถูก gitignore ไว้แล้ว)
#
# หาค่าได้ที่ https://developers.line.biz/console/
#   LINE_CHANNEL_SECRET       → แท็บ "Basic settings"  → Channel secret
#   LINE_CHANNEL_ACCESS_TOKEN → แท็บ "Messaging API"   → Channel access token (long-lived)

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# พอร์ตของ webhook server ตัวนี้ (ต้องตรงกับที่เปิด tailscale funnel)
PORT=3000

# slip-ocr-th/serve.py — ตัวที่โหลด Unlimited-OCR 4-bit ไว้
# :8101 = serve_paddle.py (PaddleOCR/CPU) · ถ้ารันด้วย docker compose ใช้ http://ocr:8101
OCR_ENDPOINT=http://localhost:8101

# ต้องมากกว่า SLIP_OCR_MAX_SECONDS ของ serve.py (default 150s) เผื่อเวลารอคิว
OCR_TIMEOUT_MS=180000

# ขนาดรูปสูงสุดที่ยอมรับ (bytes) — LINE จำกัด 10MB อยู่แล้ว
MAX_IMAGE_BYTES=10485760

# ---- สำหรับ line-bot-mcp-server (ให้ Claude สั่งส่งข้อความทดสอบ / สร้าง rich menu) ----
# .mcp.json อ่านสองตัวนี้จาก environment ของ shell ที่เปิด Claude Code
# ตั้งด้วย:  export $(grep -v '^#' .env | xargs)   ก่อนเปิด claude
LINE_DESTINATION_USER_ID=

# shared token กับ backend (ว่าง = ไม่ใช้ auth)
OCR_TOKEN=

# จำนวน thread ที่ PaddleOCR ใช้ — ตั้งให้เท่าจำนวน core จริงของเครื่อง (VPS 2 cores → 2)
OCR_THREADS=2

# URL สาธารณะของบอท — ใช้ทำลิงก์ดาวน์โหลด CSV (LINE ส่งไฟล์เองไม่ได้)
# ไม่ตั้ง = ปิดฟีเจอร์ส่งออก
PUBLIC_URL=https://bot.example.com

# จำกัดคนที่ใช้บอทได้ — LINE user ID คั่นด้วยจุลภาค (ขึ้นต้น U ตามด้วย 32 ตัว)
# ว่าง/ไม่ตั้ง = เปิดให้ทุกคนที่แอดบอท
#
# หา ID ตัวเองได้จากในแชท: พิมพ์ "ข้อมูลของฉัน" แล้วดูบรรทัดล่างสุดของการ์ด
# ใส่ผิดจนเข้าไม่ได้ก็ยังกู้ได้ — `docker compose logs bot | grep ปฏิเสธ` จะบอก ID จริง
#
# ข้อมูลของแต่ละคนแยกกันอยู่แล้ว ตัวนี้กันคิว OCR กับโควตา push 300/เดือน
# ซึ่งเป็นของส่วนกลาง คนนอกใช้แล้วกระทบเจ้าของ
# หลายคน = คั่นด้วยจุลภาค (เว้นวรรครอบจุลภาคได้)
# ALLOWED_USERS=U0123456789abcdef0123456789abcdef, Uaaaabbbbccccddddeeeeffff00001111
#
# เพิ่มคนใหม่: ให้เขาแอดบอทแล้วทักมา บอทจะตอบ ID ของเขากลับไปให้เอง
# เอา ID นั้นมาต่อท้ายบรรทัดนี้ แล้ว `docker compose up -d bot`

# ส่งออก CSV — ปิดไว้เป็นค่าเริ่มต้น ใส่ on เพื่อเปิด (ต้องมี PUBLIC_URL ด้วย)
# ไฟล์ CSV มีข้อมูลการเงินจริงทั้งก้อน จึงให้เป็นการเปิดที่ตั้งใจ ไม่ใช่ผลพลอยได้
# จากการตั้ง PUBLIC_URL เพื่อเรื่องอื่น
# EXPORT_CSV=on
