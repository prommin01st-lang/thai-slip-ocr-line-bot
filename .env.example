# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (.env ถูก gitignore ไว้แล้ว)
#
# หาค่าได้ที่ https://developers.line.biz/console/
#   LINE_CHANNEL_SECRET       → แท็บ "Basic settings"  → Channel secret
#   LINE_CHANNEL_ACCESS_TOKEN → แท็บ "Messaging API"   → Channel access token (long-lived)

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# พอร์ตของ webhook server ตัวนี้ (ต้องตรงกับที่เปิด tailscale funnel)
PORT=3000

# slip-ocr-th/serve.py — ตัวที่โหลด Unlimited-OCR 4-bit ไว้
# :8101 = serve_paddle.py (PaddleOCR/CPU) · ถ้ารันด้วย docker compose ใช้ http://ocr:8101
OCR_ENDPOINT=http://localhost:8101

# ต้องมากกว่า SLIP_OCR_MAX_SECONDS ของ serve.py (default 150s) เผื่อเวลารอคิว
OCR_TIMEOUT_MS=180000

# ขนาดรูปสูงสุดที่ยอมรับ (bytes) — LINE จำกัด 10MB อยู่แล้ว
MAX_IMAGE_BYTES=10485760

# ไฟล์แนบ: PDF และไฟล์ข้อความ/CSV
# LINE ยอมให้ส่งไฟล์ได้ใหญ่กว่ารูปมาก แต่คอนเทนเนอร์ bot จำกัดหน่วยความจำไว้ 256MB
# ทั้งสองค่านี้ถูกตรวจ **ก่อนโหลดไฟล์** จาก fileSize ที่ LINE ส่งมาใน event
# MAX_PDF_BYTES=10485760
# MAX_TEXT_BYTES=2097152

# ---- สำหรับ line-bot-mcp-server (ให้ Claude สั่งส่งข้อความทดสอบ / สร้าง rich menu) ----
# .mcp.json อ่านสองตัวนี้จาก environment ของ shell ที่เปิด Claude Code
# ตั้งด้วย:  export $(grep -v '^#' .env | xargs)   ก่อนเปิด claude
LINE_DESTINATION_USER_ID=

# shared token กับ backend (ว่าง = ไม่ใช้ auth)
OCR_TOKEN=

# จำนวน thread ที่ PaddleOCR ใช้ — ตั้งให้เท่าจำนวน core จริงของเครื่อง (VPS 2 cores → 2)
OCR_THREADS=2

# URL สาธารณะของบอท — ใช้ทำลิงก์ดาวน์โหลด CSV (LINE ส่งไฟล์เองไม่ได้)
# ไม่ตั้ง = ปิดฟีเจอร์ส่งออก
PUBLIC_URL=https://bot.example.com

# จำกัดคนที่ใช้บอทได้ — LINE user ID คั่นด้วยจุลภาค (ขึ้นต้น U ตามด้วย 32 ตัว)
# ว่าง/ไม่ตั้ง = เปิดให้ทุกคนที่แอดบอท
#
# หา ID ตัวเองได้จากในแชท: พิมพ์ "ข้อมูลของฉัน" — บอทส่งการ์ดแล้วตามด้วย
# ข้อความที่มี ID ล้วน ๆ กดค้างคัดลอกได้เลย (ตัวอักษรในการ์ด Flex คัดลอกไม่ได้)
# ใส่ผิดจนเข้าไม่ได้ก็ยังกู้ได้ — `docker compose logs bot | grep ปฏิเสธ` จะบอก ID จริง
#
# ข้อมูลของแต่ละคนแยกกันอยู่แล้ว ตัวนี้กันคิว OCR กับโควตา push 300/เดือน
# ซึ่งเป็นของส่วนกลาง คนนอกใช้แล้วกระทบเจ้าของ
# หลายคน = คั่นด้วยจุลภาค (เว้นวรรครอบจุลภาคได้)
# ALLOWED_USERS=U0123456789abcdef0123456789abcdef, Uaaaabbbbccccddddeeeeffff00001111
#
# เพิ่มคนใหม่ **ไม่ต้องแก้ไฟล์นี้แล้ว** — ให้เขาแอดบอทแล้วกดปุ่ม "ขอสิทธิ์ใช้งาน"
# แอดมินจะได้การ์ดแจ้งพร้อมปุ่มอนุมัติ/ปฏิเสธในแชท มีผลทันทีไม่ต้อง restart
# แอดมินพิมพ์ "คำขอ" ดูที่ค้าง · "ผู้ใช้" ดูคนที่อนุมัติไปแล้ว

# แอดมิน — อนุมัติคำขอของคนอื่นได้ ไม่ตั้ง = ใช้ ALLOWED_USERS ทั้งก้อนเป็นแอดมิน
# **ตั้งได้จากไฟล์นี้เท่านั้น ตั้งจากในแชทไม่ได้** โดยตั้งใจ
# ADMIN_USERS=U0123456789abcdef0123456789abcdef

# ส่งออก CSV — ปิดไว้เป็นค่าเริ่มต้น ใส่ on เพื่อเปิด (ต้องมี PUBLIC_URL ด้วย)
# ไฟล์ CSV มีข้อมูลการเงินจริงทั้งก้อน จึงให้เป็นการเปิดที่ตั้งใจ ไม่ใช่ผลพลอยได้
# จากการตั้ง PUBLIC_URL เพื่อเรื่องอื่น
# EXPORT_CSV=on

# ---- Google Sheet ของผู้ใช้ (ไม่บังคับ) ----
#
# เปิดแล้วผู้ใช้จะเชื่อมชีตของตัวเองได้ ทุกรายการจะถูกคัดลอกขึ้นไปให้อัตโนมัติ
# **SQLite ยังเป็นแหล่งข้อมูลจริงเสมอ ชีตเป็นสำเนาทางเดียว** (แก้ในชีตจะถูกเขียนทับ)
# ไม่ตั้งสองค่านี้ = ปุ่ม/คำสั่งเรื่องชีตไม่โผล่เลย ระบบทำงานเหมือนเดิมทุกอย่าง
#
# วิธีได้ค่ามา (ทำครั้งเดียว ฟรี ไม่ต้องเปิดบัตร):
#   1. console.cloud.google.com → สร้าง project
#   2. เปิดใช้ "Google Sheets API"
#   3. IAM & Admin → Service Accounts → Create → ไม่ต้องให้ role อะไรเลย
#   4. แท็บ Keys → Add key → JSON → ได้ไฟล์มา
#   5. เอา client_email กับ private_key จากไฟล์นั้นมาใส่ข้างล่าง
#
# ผู้ใช้แต่ละคนแค่กด "แชร์" ชีตของตัวเองให้อีเมลนี้เป็น "ผู้แก้ไข" แล้วส่งลิงก์เข้าแชท
# → ไม่ต้องทำ OAuth consent screen ไม่ต้องผ่าน Google verification ไม่ต้องเก็บ token รายคน
#
# 🔒 GOOGLE_SA_KEY คือ **private key จริง** — ไฟล์ .env ถูก gitignore ไว้แล้ว ห้าม commit
#    ต้องครอบด้วยอัญประกาศและคง `\n` ไว้ตามที่ก๊อปมาจาก JSON (โค้ดแปลงกลับให้เอง)
# GOOGLE_SA_EMAIL=slipingman@your-project.iam.gserviceaccount.com
# GOOGLE_SA_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADAN...\n-----END PRIVATE KEY-----\n"
#
# ทุกกี่มิลลิวินาทีถึง sync รอบหนึ่ง (ค่าเริ่มต้น 20 วิ)
# SHEET_SYNC_MS=20000

# ---- หลักฐานส่วนตัว (S3-compatible; ปิดจนกว่าจะตั้ง bucket แล้ว) ----
EVIDENCE_ENABLED=off
S3_BUCKET=
S3_REGION=auto
# AWS S3 ใช้ endpoint มาตรฐานได้; R2/MinIO ให้ใส่ HTTPS endpoint
S3_ENDPOINT=
# เว้น credentials ได้เมื่อใช้ IAM role; อย่าใส่ไว้ใน repository
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# ใช้สำหรับ check-env --online เพื่อตรวจสิทธิ์อ่านชีตทดสอบเท่านั้น
# CHECK_SPREADSHEET_ID=
# Production บังคับ ADMIN_USERS, OCR_TOKEN >=32 ตัว, LINE secret 32 hex และ PUBLIC_URL เป็น HTTPS
# ดู .env.production.example และ docs/PRODUCTION.md

# Allow plain HTTP only for storage:8333 on the isolated Docker network in compose.storage.yml.
S3_INTERNAL_NETWORK=off
