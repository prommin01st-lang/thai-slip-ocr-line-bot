{
  "name": "thai-slip-ocr-line-bot",
  "version": "0.1.0",
  "description": "Read Thai bank slips, receipts and payslips from a photo inside LINE chat and keep an income/expense ledger. PaddleOCR on CPU — no GPU, no LLM.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.js",
    "test": "node test/run.mjs",
    "dev:all": "./dev.sh",
    "tunnel": "tailscale funnel --bg 3000",
    "tunnel:off": "tailscale funnel --https=443 off",
    "richmenu": "node scripts/richmenu.mjs",
    "weekly": "node --disable-warning=ExperimentalWarning scripts/weekly.mjs",
    "check:env": "node scripts/check-env.mjs --production"
  },
  "keywords": [
    "thai",
    "ocr",
    "slip",
    "bank-slip",
    "receipt-ocr",
    "payslip",
    "line-bot",
    "line-messaging-api",
    "paddleocr",
    "expense-tracker",
    "thai-ocr",
    "self-hosted",
    "docker",
    "nodejs",
    "sqlite"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@line/bot-sdk": "^11.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pdfkit": "^0.20.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_USER/thai-slip-ocr-line-bot.git"
  }
}
